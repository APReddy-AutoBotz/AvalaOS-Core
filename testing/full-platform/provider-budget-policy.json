{
  "schemaVersion": "avalaos-provider-budget-policy/v1",
  "status": "planned_verification",
  "liveCallsEnabled": false,
  "providers": [
    { "provider": "openai", "secretFilePresenceOnly": ".env.openai.local", "serverOnly": true, "approvedModel": null },
    { "provider": "groq", "secretFilePresenceOnly": ".env.groq.local", "serverOnly": true, "approvedModel": null }
  ],
  "requiredBeforeEnable": [
    "simulation and malformed-output cases pass",
    "key presence and variable-name checks pass without reading values into evidence",
    "provider route is tenant/workspace scoped and server authoritative",
    "current model identity and price source are recorded outside retained evidence",
    "the user explicitly approves exact provider, model, request, token, and estimated-cost ceilings"
  ],
  "hardCeilings": {
    "campaignRequests": null,
    "requestsPerProvider": null,
    "inputTokensPerRequest": null,
    "outputTokensPerRequest": null,
    "estimatedCampaignUsd": null,
    "concurrency": 1
  },
  "localDiagnosticGate": {
    "enabledByDefault": false,
    "evidenceBoundary": "local_nonproduction_diagnostic_not_pr255_acceptance",
    "execution": "serial_no_retry",
    "models": [
      { "provider": "openai", "model": "gpt-4.1-nano", "inputUsdPerMillion": 0.1, "outputUsdPerMillion": 0.4, "priceCheckedAt": "2026-08-24", "source": "https://developers.openai.com/api/docs/models/gpt-4.1-nano" },
      { "provider": "groq", "model": "openai/gpt-oss-20b", "inputUsdPerMillion": 0.075, "outputUsdPerMillion": 0.3, "priceCheckedAt": "2026-08-24", "source": "https://console.groq.com/docs/model/openai/gpt-oss-20b" }
    ],
    "hardCeilings": { "campaignRequests": 2, "inputTokens": 256, "outputTokens": 192, "totalTokens": 448, "estimatedCampaignUsd": 0.001, "concurrency": 1 }
  },
  "circuitBreakers": [
    "stop before the first paid call while any ceiling is null",
    "stop on tenant/workspace/provider-route mismatch",
    "stop on unapproved model substitution or redirect",
    "stop on retry that would exceed the request ceiling",
    "stop on cost-estimate uncertainty or provider usage disagreement",
    "stop on raw secret, prompt, response, or credential-bearing log detection",
    "stop after the first unexpected provider call"
  ],
  "retention": {
    "allowed": ["provider name", "approved model alias", "sanitized status", "token counts", "bounded cost estimate", "request correlation hash"],
    "prohibited": ["raw key", "raw prompt", "raw response", "provider account identifier", "credential header", "full endpoint with query"]
  }
}
