{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.example/schemas/full-platform-campaign-v1.json",
  "title": "AvalaOS full-platform campaign definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "status", "canonicalCatalogSource", "canonicalInventorySource", "canonicalProvenanceSource", "canonicalExecutionBindingsSource", "visibleViewSource", "personaSource", "outputRoot", "trackedDefinitionRoot", "requiredCounts", "entryGates", "evidenceRules", "requiredDevices", "resultVocabulary", "nonClaims", "rollbackDocument"],
  "properties": {
    "schemaVersion": { "const": "avalaos-full-platform-campaign/v1" },
    "campaignId": { "const": "avalaos-full-platform-synthetic-v1" },
    "status": { "const": "planned_verification" },
    "canonicalCatalogSource": { "const": "tests/acceptance/catalog/test-catalog.json" },
    "canonicalInventorySource": { "const": "tests/acceptance/inventory.json" },
    "canonicalProvenanceSource": { "const": "tests/acceptance/source-provenance.json" },
    "canonicalExecutionBindingsSource": { "const": "tests/acceptance/execution-bindings.json" },
    "visibleViewSource": { "const": "types.ts" },
    "personaSource": { "const": "data/mockData.ts" },
    "outputRoot": { "const": "output/full-platform" },
    "trackedDefinitionRoot": { "const": "testing/full-platform" },
    "requiredCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibleViews", "catalogCases", "catalogBranches", "personas", "organizations", "workspaces"],
      "properties": {
        "visibleViews": { "const": 24 },
        "catalogCases": { "const": 108 },
        "catalogBranches": { "const": 108 },
        "personas": { "const": 7 },
        "organizations": { "const": 2 },
        "workspaces": { "const": 2 }
      }
    },
    "entryGates": { "type": "array", "minItems": 8, "items": { "type": "string", "minLength": 1 } },
    "evidenceRules": { "type": "object" },
    "requiredDevices": { "const": ["desktop-chromium", "pixel-7-chromium"] },
    "resultVocabulary": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "nonClaims": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "type": "string" } },
    "rollbackDocument": { "const": "testing/full-platform/cleanup-and-rollback.md" }
  }
}
