{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.example/schemas/full-platform-run-evidence-v1.json",
  "title": "Sanitized AvalaOS full-platform run evidence",
  "description": "Generated instances belong under output/full-platform/<run-id>/ and must never contain secrets, raw prompts/responses, raw logs, signed URLs, customer data, provider account identifiers, storage identifiers, or production identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "runId", "status", "executionIdentity", "coverage", "testResults", "browserSession", "sanitization"],
  "properties": {
    "schemaVersion": { "const": "avalaos-full-platform-run-evidence/v1" },
    "campaignId": { "const": "avalaos-full-platform-synthetic-v1" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,79}$" },
    "status": { "enum": ["executed evidence", "blocked", "not run", "confirmed source defect", "suspected defect requiring deeper validation"] },
    "executionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSha", "workflowPath", "runId", "runAttempt", "latestRunAttempt", "environment", "organizationId", "workspaceId"],
      "properties": {
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workflowPath": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._/-]+\\.yml$" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "latestRunAttempt": { "type": "integer", "minimum": 1 },
        "environment": { "enum": ["local_disposable", "disposable_ci", "hosted_nonproduction_pilot"] },
        "organizationId": { "type": "string", "format": "uuid" },
        "workspaceId": { "type": "string", "format": "uuid" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogCases", "recordedTestIds", "complete"],
      "properties": {
        "catalogCases": { "const": 108 },
        "recordedTestIds": { "type": "integer", "minimum": 0, "maximum": 108 },
        "complete": { "type": "boolean" }
      }
    },
    "testResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testId", "bindingResults", "sourceProof", "status"],
        "properties": {
          "testId": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3}$" },
          "bindingResults": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bindingKind", "ownerId", "canonicalCommand", "suiteExitCode", "assertionOutcomes"],
              "properties": {
                "bindingKind": { "enum": ["retained-assertion", "oracle-scenario", "hosted-scenario", "server-assertion"] },
                "ownerId": { "type": "string", "minLength": 1 },
                "canonicalCommand": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
                "suiteExitCode": { "type": "integer" },
                "assertionOutcomes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["assertionId", "outcome"],
                    "properties": {
                      "assertionId": { "type": "string", "minLength": 1 },
                      "outcome": { "enum": ["passed", "failed", "skipped", "blocked", "not_run"] }
                    }
                  }
                }
              }
            }
          },
          "sourceProof": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$" },
                "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          },
          "status": { "enum": ["executed evidence", "blocked", "not run", "confirmed source defect", "suspected defect requiring deeper validation"] }
        }
      }
    },
    "browserSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testIds", "personasCompleted", "observer", "routeAssertions"],
      "properties": {
        "testIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "personasCompleted": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string" } },
        "observer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startedBeforeEntry", "endedAfterSignOutQuietWindow", "quietWindowRestartedOnLateRequest", "postObserverProviderRequests"],
          "properties": {
            "startedBeforeEntry": { "const": true },
            "endedAfterSignOutQuietWindow": { "const": true },
            "quietWindowRestartedOnLateRequest": { "const": true },
            "postObserverProviderRequests": { "const": [] }
          }
        },
        "routeAssertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pathClass", "classification"],
            "properties": {
              "pathClass": { "enum": ["sandbox_descendant", "authenticated_entry"] },
              "classification": { "enum": ["accepted_synthetic", "separate_authenticated_entry"] }
            }
          }
        }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawSecrets", "rawPrompts", "rawResponses", "rawLogs", "signedUrls", "customerData", "realProviderIdentifiers", "productionIdentifiers"],
      "properties": {
        "rawSecrets": { "const": false },
        "rawPrompts": { "const": false },
        "rawResponses": { "const": false },
        "rawLogs": { "const": false },
        "signedUrls": { "const": false },
        "customerData": { "const": false },
        "realProviderIdentifiers": { "const": false },
        "productionIdentifiers": { "const": false }
      }
    }
  }
}
