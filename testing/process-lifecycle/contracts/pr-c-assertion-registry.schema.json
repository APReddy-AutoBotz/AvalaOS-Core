{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.invalid/contracts/governed-delivery-monitor-pr-c-assertion-registry.schema.json",
  "title": "Governed Delivery and Monitor PR C assertion registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "workflowPath",
    "provenancePath",
    "fixtureRegistryPath",
    "personasRegistryPath",
    "commands",
    "owners",
    "assertions",
    "notRun"
  ],
  "properties": {
    "contractVersion": { "const": "governed-delivery-monitor-pr-c-registry-1" },
    "workflowPath": { "const": ".github/workflows/transcript-flow-pr-c.yml" },
    "provenancePath": { "const": "testing/process-lifecycle/contracts/pr-c-source-provenance.json" },
    "fixtureRegistryPath": { "const": "testing/process-lifecycle/fixtures/delivery-monitor-pr-c/fixture-registry.json" },
    "personasRegistryPath": { "const": "testing/process-lifecycle/fixtures/delivery-monitor-pr-c/personas.json" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "environment"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "requiredEnvironment": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          }
        }
      }
    },
    "owners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "owner", "testId", "assertionId", "fixture", "testName", "expectedRuntimeContext"],
        "properties": {
          "commandId": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "testId": { "type": "string", "minLength": 1 },
          "assertionId": { "type": "string", "minLength": 1 },
          "fixture": { "type": "string", "minLength": 1 },
          "testName": { "type": "string", "minLength": 1 },
          "expectedRuntimeContext": {
            "type": "object",
            "required": ["persona", "organizationId", "workspaceId"],
            "properties": {
              "persona": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "state", "capabilities"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "state": { "enum": ["active", "revoked", "stale", "unauthorized"] },
                  "capabilities": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "organizationId": { "type": "string", "minLength": 1 },
              "workspaceId": { "type": "string", "minLength": 1 }
              ,
              "participants": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "state", "capabilities"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "state": { "enum": ["active", "revoked", "stale", "unauthorized"] },
                    "capabilities": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notRun": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testId", "owner", "testName", "command", "reason"],
        "properties": {
          "testId": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "testName": { "type": "string", "minLength": 1 },
          "command": { "type": "null" },
          "reason": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
