{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.invalid/schemas/pr-c-controlled-human-checkpoint-3.json",
  "title": "Governed Delivery and Monitor PR C signed human checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "automationGenerated", "preparationDigest", "quiesceDigest", "humanRole", "signerDigest", "capture", "serverObserver", "checkpoints", "signature"],
  "properties": {
    "schemaVersion": { "const": "governed-delivery-monitor-pr-c-human-checkpoint-3" },
    "status": { "const": "human_observation" },
    "automationGenerated": { "const": false },
    "preparationDigest": { "$ref": "#/$defs/digest" },
    "quiesceDigest": { "$ref": "#/$defs/digest" },
    "humanRole": { "enum": ["requester", "reviewer", "approver"] },
    "signerDigest": { "$ref": "#/$defs/hmac" },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowPath", "event", "runId", "runAttempt", "commentId", "commentCreatedAt", "capturedAt"],
      "properties": {
        "workflowPath": { "const": ".github/workflows/pr264-controlled-human-checkpoint.yml" }, "event": { "const": "pull_request" },
        "runId": { "$ref": "#/$defs/id" }, "runAttempt": { "type": "integer", "minimum": 1 }, "commentId": { "$ref": "#/$defs/id" },
        "commentCreatedAt": { "type": "string", "format": "date-time" }, "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "serverObserver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactDigest", "record"],
      "properties": { "artifactDigest": { "$ref": "#/$defs/digest" }, "record": { "$ref": "#/$defs/serverObserver" } }
    },
    "checkpoints": { "type": "array", "minItems": 1, "maxItems": 14, "items": { "$ref": "#/$defs/checkpoint" } },
    "signature": { "$ref": "#/$defs/hmac" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hmac": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "safeLabel": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "nonnegative": { "type": "integer", "minimum": 0 },
    "browserContent": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "route", "viewport", "assertions", "interactionSequence", "serverAnchor", "serverBinding"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/safeLabel" }, "route": { "type": "string", "pattern": "^/[a-z0-9/_?=&.-]{0,255}$" },
        "viewport": { "$ref": "#/$defs/safeLabel" },
        "assertions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeLabel" } },
        "interactionSequence": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/safeLabel" } },
        "serverAnchor": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/stepAnchor" }] },
        "serverBinding": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/stepBinding" }] }
      }
    },
    "stepAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "stepId", "action", "targetFamily", "targetDigest", "expectedVersion", "transitionKind", "selectorDigest", "intentDigest", "requestDigest", "challengeToken", "anchoredAt"],
      "properties": {
        "contractVersion": { "const": "pr-c-controlled-human-step-anchor-1" }, "stepId": { "$ref": "#/$defs/safeLabel" }, "action": { "$ref": "#/$defs/safeLabel" },
        "targetFamily": { "$ref": "#/$defs/safeLabel" }, "targetDigest": { "$ref": "#/$defs/digest" }, "expectedVersion": { "type": "integer", "minimum": 0 },
        "transitionKind": { "enum": ["same", "increment_one", "create_one", "create_zero", "replay_existing"] }, "selectorDigest": { "$ref": "#/$defs/digest" }, "intentDigest": { "$ref": "#/$defs/digest" },
        "requestDigest": { "$ref": "#/$defs/digest" }, "challengeToken": { "$ref": "#/$defs/digest" }, "anchoredAt": { "type": "string", "format": "date-time" }
      }
    },
    "stepBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "stepId", "action", "result", "resourceFamily", "resourceDigest", "expectedVersion", "observedVersion", "requestDigest", "receiptDigest", "auditDigest", "intentDigest", "denialCodeDigest", "bindingToken", "anchorToken", "causalParentBindingToken", "causalParentResourceDigest", "causalLineageDigest", "issuedAt"],
      "properties": {
        "contractVersion": { "const": "pr-c-controlled-human-step-binding-3" }, "stepId": { "$ref": "#/$defs/safeLabel" },
        "action": { "$ref": "#/$defs/safeLabel" }, "result": { "enum": ["succeeded", "denied"] }, "resourceFamily": { "$ref": "#/$defs/safeLabel" },
        "resourceDigest": { "$ref": "#/$defs/digest" }, "expectedVersion": { "type": "integer", "minimum": 0 }, "observedVersion": { "type": "integer", "minimum": 0 },
        "requestDigest": { "$ref": "#/$defs/digest" }, "receiptDigest": { "$ref": "#/$defs/digest" }, "auditDigest": { "$ref": "#/$defs/digest" }, "intentDigest": { "$ref": "#/$defs/digest" }, "denialCodeDigest": { "$ref": "#/$defs/digest" },
        "bindingToken": { "$ref": "#/$defs/digest" }, "anchorToken": { "$ref": "#/$defs/digest" },
        "causalParentBindingToken": { "$ref": "#/$defs/digest" }, "causalParentResourceDigest": { "$ref": "#/$defs/digest" }, "causalLineageDigest": { "$ref": "#/$defs/digest" },
        "issuedAt": { "type": "string", "format": "date-time" }
      }
    },
    "browserArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["content", "byteLength", "digest"],
      "properties": { "content": { "$ref": "#/$defs/browserContent" }, "byteLength": { "type": "integer", "minimum": 1 }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "humanStep": {
      "type": "object", "additionalProperties": false,
      "required": ["stepId", "personaKey", "outcome", "startedAt", "completedAt", "browserArtifact"],
      "properties": {
        "stepId": { "$ref": "#/$defs/safeLabel" }, "personaKey": { "$ref": "#/$defs/safeLabel" }, "outcome": { "const": "passed" },
        "startedAt": { "type": "string", "format": "date-time" }, "completedAt": { "type": "string", "format": "date-time" },
        "browserArtifact": { "$ref": "#/$defs/browserArtifact" }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpointId", "journeyId", "testIds", "steps"],
      "properties": {
        "checkpointId": { "type": "string", "pattern": "^CH-(?:0[1-9]|1[0-4])$" }, "journeyId": { "$ref": "#/$defs/safeLabel" },
        "testIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeLabel" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/humanStep" } }
      }
    },
    "deltas": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt", "audit", "target", "itemVersion", "approval", "baseline"],
      "properties": {
        "receipt": { "$ref": "#/$defs/nonnegative" }, "audit": { "$ref": "#/$defs/nonnegative" }, "target": { "$ref": "#/$defs/nonnegative" },
        "itemVersion": { "$ref": "#/$defs/nonnegative" }, "approval": { "$ref": "#/$defs/nonnegative" }, "baseline": { "$ref": "#/$defs/nonnegative" }
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["providerEgress", "realProviderCalls", "customerDataRecords", "externalUsers"],
      "properties": { "providerEgress": { "const": 0 }, "realProviderCalls": { "const": 0 }, "customerDataRecords": { "const": 0 }, "externalUsers": { "const": 0 } }
    },
    "serverStep": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpointId", "stepId", "personaKey", "authenticatedPersonaDigest", "capabilityDigest", "scopeDigest", "action", "resourceKind", "resourceFamily", "humanAttemptDigest", "bindingToken", "safeBindingDigest", "causalEventDigest", "resourceDigest", "expectedVersion", "version", "requestIdentityDigest", "receiptDigest", "auditDigest", "observationKind", "result", "denialProofKind", "denialCodeDigest", "observedDeltas", "safety", "serverObservedAt", "inspectionDigest"],
      "properties": {
        "checkpointId": { "type": "string", "pattern": "^CH-(?:0[1-9]|1[0-4])$" }, "stepId": { "$ref": "#/$defs/safeLabel" }, "personaKey": { "$ref": "#/$defs/safeLabel" },
        "authenticatedPersonaDigest": { "$ref": "#/$defs/digest" }, "capabilityDigest": { "$ref": "#/$defs/digest" }, "scopeDigest": { "$ref": "#/$defs/digest" },
        "action": { "$ref": "#/$defs/safeLabel" }, "resourceKind": { "$ref": "#/$defs/safeLabel" }, "resourceFamily": { "$ref": "#/$defs/safeLabel" }, "humanAttemptDigest": { "$ref": "#/$defs/digest" }, "bindingToken": { "$ref": "#/$defs/digest" }, "safeBindingDigest": { "$ref": "#/$defs/digest" }, "causalEventDigest": { "$ref": "#/$defs/digest" }, "resourceDigest": { "$ref": "#/$defs/digest" },
        "expectedVersion": { "$ref": "#/$defs/nonnegative" }, "version": { "$ref": "#/$defs/nonnegative" }, "requestIdentityDigest": { "$ref": "#/$defs/digest" }, "receiptDigest": { "$ref": "#/$defs/digest" }, "auditDigest": { "$ref": "#/$defs/digest" },
        "observationKind": { "enum": ["server_event", "human_attestation", "negative_attempt", "no_effect"] },
        "result": { "enum": ["succeeded", "attested", "denied", "no_effect_observed"] },
        "denialProofKind": { "enum": ["denied_audit", "server_denied_attempt", "not_applicable"] },
        "denialCodeDigest": { "$ref": "#/$defs/digest" }, "observedDeltas": { "$ref": "#/$defs/deltas" },
        "safety": { "$ref": "#/$defs/safety" }, "serverObservedAt": { "type": "string", "format": "date-time" }, "inspectionDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "serverObserver": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "phase", "status", "environmentClass", "releaseSha", "reviewHeadSha", "prNumber", "deployId", "deployOrigin", "exerciseDigest", "targetFingerprint", "publicTargetDigest", "personaManifestDigest", "fixtureManifestDigest", "migrationTip", "productionAuthorized", "customerDataAuthorized", "realProviderCallsAuthorized", "humanRole", "requestDigest", "observedAt", "lifecycle", "concurrencyVersion", "operationEventSequence", "operationEventDigest", "immutableHistoryDigest", "inspectionDigest", "steps"],
      "properties": {
        "contractVersion": { "const": "pr-c-controlled-human-controller-1" }, "phase": { "const": "checkpoint-observe" }, "status": { "const": "passed" },
        "environmentClass": { "const": "hosted_nonproduction_pilot" }, "releaseSha": { "$ref": "#/$defs/sha" }, "reviewHeadSha": { "$ref": "#/$defs/sha" },
        "prNumber": { "const": 264 }, "deployId": { "type": "string", "pattern": "^[0-9a-f]{24}$" }, "deployOrigin": { "const": "https://deploy-preview-264--avalaos-pilot.netlify.app" },
        "exerciseDigest": { "$ref": "#/$defs/digest" }, "targetFingerprint": { "$ref": "#/$defs/digest" }, "publicTargetDigest": { "$ref": "#/$defs/digest" }, "personaManifestDigest": { "$ref": "#/$defs/digest" },
        "fixtureManifestDigest": { "$ref": "#/$defs/digest" }, "migrationTip": { "const": "20260904120000" },
        "productionAuthorized": { "const": false }, "customerDataAuthorized": { "const": false }, "realProviderCallsAuthorized": { "const": false },
        "humanRole": { "enum": ["requester", "reviewer", "approver"] }, "requestDigest": { "$ref": "#/$defs/digest" }, "observedAt": { "type": "string", "format": "date-time" },
        "lifecycle": { "enum": ["active", "read_only"] }, "concurrencyVersion": { "type": "integer", "minimum": 1 }, "operationEventSequence": { "type": "integer", "minimum": 1 },
        "operationEventDigest": { "$ref": "#/$defs/digest" }, "immutableHistoryDigest": { "$ref": "#/$defs/digest" }, "inspectionDigest": { "$ref": "#/$defs/digest" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/serverStep" } }
      }
    }
  }
}
