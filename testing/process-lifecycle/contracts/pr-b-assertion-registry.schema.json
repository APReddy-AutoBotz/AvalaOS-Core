{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.invalid/contracts/governed-multisource-studio-pr-b-assertion-registry.schema.json",
  "title": "Governed multi-source transcript Studio PR B assertion registry",
  "$defs": {
    "uuidV4Matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$uuidV4"],
      "properties": { "$uuidV4": { "const": true } }
    },
    "sha256Matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$sha256"],
      "properties": { "$sha256": { "const": true } }
    },
    "integerMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$integer"],
      "properties": {
        "$integer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "maxExclusive"],
          "properties": {
            "min": { "type": "integer" },
            "maxExclusive": { "type": "integer" }
          }
        }
      }
    },
    "numberArrayMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$numberArray"],
      "properties": {
        "$numberArray": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length", "min", "maxExclusive"],
          "properties": {
            "length": { "type": "integer", "minimum": 0 },
            "min": { "type": "number" },
            "maxExclusive": { "type": "number" }
          }
        }
      }
    },
    "runtimeLineageValue": {
      "oneOf": [
        { "$ref": "#/$defs/uuidV4Matcher" },
        { "$ref": "#/$defs/sha256Matcher" },
        { "$ref": "#/$defs/integerMatcher" },
        { "$ref": "#/$defs/numberArrayMatcher" },
        { "type": ["string", "number", "boolean", "null"] },
        {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/runtimeLineageValue" }
        },
        {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": { "not": { "pattern": "^\\$" } },
          "additionalProperties": { "$ref": "#/$defs/runtimeLineageValue" }
        }
      ]
    },
    "runtimeLineageObject": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": { "not": { "pattern": "^\\$" } },
      "additionalProperties": { "$ref": "#/$defs/runtimeLineageValue" }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "workflowPath",
    "provenancePath",
    "fixtureRegistryPath",
    "commands",
    "owners",
    "assertions",
    "notRun"
  ],
  "properties": {
    "contractVersion": { "const": "governed-multisource-studio-pr-b-registry-1" },
    "workflowPath": { "const": ".github/workflows/transcript-flow-pr-b.yml" },
    "provenancePath": { "const": "testing/process-lifecycle/contracts/pr-b-source-provenance.json" },
    "fixtureRegistryPath": { "const": "testing/process-lifecycle/fixtures/studio-pr-b/fixture-registry.json" },
    "commands": {
      "type": "array",
      "minItems": 61,
      "maxItems": 61,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "environment"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "command": { "type": "string", "pattern": "^(npm|git) " },
          "environment": { "type": "string", "pattern": "^controlled-" },
          "requiredEnvironment": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          }
        }
      }
    },
    "owners": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 55,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "owner", "testId", "assertionId", "fixture", "testName", "expectedRuntimeContext"],
        "properties": {
          "commandId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "owner": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "testId": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "assertionId": { "type": "string", "minLength": 1 },
          "fixture": { "type": "string", "minLength": 1 },
          "testName": { "type": "string", "minLength": 1 },
          "expectedRuntimeContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["persona", "organizationId", "workspaceId", "lineage"],
            "properties": {
              "persona": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "state", "capabilities"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "state": { "enum": ["active", "revoked", "revoked-then-restored", "stale", "unauthorized"] },
                  "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
                }
              },
              "organizationId": { "type": "string", "minLength": 1 },
              "workspaceId": { "type": "string", "minLength": 1 },
              "lineage": { "$ref": "#/$defs/runtimeLineageObject" }
            }
          }
        }
      }
    },
    "notRun": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testId", "owner", "testName", "reason"],
        "properties": {
          "testId": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "owner": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "testName": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
