{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.invalid/schemas/pr-c-controlled-human-session-2.json",
  "title": "Governed Delivery and Monitor PR C verified controlled-human session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "controlledHumanDisposition", "evidenceBasis", "preparationDigest", "exactHead", "github", "preview", "backendBinding", "humanParticipants", "journeys", "checkpoints", "totals", "defectHistory", "lifecycleControl", "reset", "completedAt"],
  "properties": {
    "schemaVersion": { "const": "governed-delivery-monitor-pr-c-human-session-2" },
    "status": { "const": "passed" },
    "controlledHumanDisposition": { "const": "executed" },
    "evidenceBasis": { "const": "human_attested_plus_server_observed" },
    "preparationDigest": { "$ref": "#/$defs/digest" },
    "exactHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "github": { "$ref": "#/$defs/ciRecord" },
    "preview": { "$ref": "#/$defs/preview" },
    "backendBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["targetFingerprint", "publicTargetDigest", "exerciseDigest", "seedControllerDigest", "resetControllerDigest", "postResetVerificationDigest", "quiesceControllerDigest", "edgeDeploymentManifestDigest"],
      "properties": {
        "targetFingerprint": { "$ref": "#/$defs/digest" }, "publicTargetDigest": { "$ref": "#/$defs/digest" }, "exerciseDigest": { "$ref": "#/$defs/digest" }, "seedControllerDigest": { "$ref": "#/$defs/digest" },
        "resetControllerDigest": { "$ref": "#/$defs/digest" }, "postResetVerificationDigest": { "$ref": "#/$defs/digest" },
        "quiesceControllerDigest": { "$ref": "#/$defs/digest" }, "edgeDeploymentManifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "humanParticipants": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/participant" } },
    "journeys": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/journey" } },
    "checkpoints": { "type": "array", "minItems": 14, "maxItems": 14, "items": { "$ref": "#/$defs/checkpoint" } },
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["journeyCount", "checkpointCount", "stepCount", "passedStepCount", "failedStepCount", "blockedStepCount", "providerEgressCount", "realProviderCallCount", "customerDataRecordCount", "externalUserCount"],
      "properties": {
        "journeyCount": { "const": 8 }, "checkpointCount": { "const": 14 }, "stepCount": { "const": 83 }, "passedStepCount": { "const": 83 },
        "failedStepCount": { "const": 0 }, "blockedStepCount": { "const": 0 }, "providerEgressCount": { "const": 0 },
        "realProviderCallCount": { "const": 0 }, "customerDataRecordCount": { "const": 0 }, "externalUserCount": { "const": 0 }
      }
    },
    "defectHistory": { "type": "array", "items": { "$ref": "#/$defs/defect" } },
    "lifecycleControl": {
      "type": "object", "additionalProperties": false,
      "required": ["quiesceDigest", "quiescedHistoryDigest"],
      "properties": { "quiesceDigest": { "$ref": "#/$defs/digest" }, "quiescedHistoryDigest": { "$ref": "#/$defs/digest" } }
    },
    "reset": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "controllerDigest", "postVerificationDigest", "postInspectionDigest"],
      "properties": {
        "status": { "const": "verified_deprovisioned" }, "controllerDigest": { "$ref": "#/$defs/digest" },
        "postVerificationDigest": { "$ref": "#/$defs/digest" }, "postInspectionDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hmac": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "safeLabel": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "ciRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowPath", "runId", "runAttempt", "conclusion", "artifactName", "artifactDigest"],
      "properties": {
        "workflowPath": { "const": ".github/workflows/transcript-flow-pr-c.yml" }, "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "integer", "minimum": 1 }, "conclusion": { "const": "success" },
        "artifactName": { "$ref": "#/$defs/safeLabel" }, "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "deployId", "releaseSha", "context", "reviewId", "siteName", "environment"],
      "properties": {
        "origin": { "const": "https://deploy-preview-264--avalaos-pilot.netlify.app" }, "deployId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "releaseSha": { "$ref": "#/$defs/sha" }, "context": { "const": "deploy-preview" }, "reviewId": { "const": 264 },
        "siteName": { "const": "avalaos-pilot" }, "environment": { "const": "hosted_nonproduction_pilot" }
      }
    },
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "signerDigest"],
      "properties": { "role": { "enum": ["requester", "reviewer", "approver"] }, "signerDigest": { "$ref": "#/$defs/hmac" } }
    },
    "journey": {
      "type": "object", "additionalProperties": false,
      "required": ["journeyId", "checkpointIds", "outcome"],
      "properties": {
        "journeyId": { "$ref": "#/$defs/safeLabel" }, "checkpointIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^CH-(?:0[1-9]|1[0-4])$" } },
        "outcome": { "const": "passed" }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpointId", "journeyId", "outcome", "stepCount", "observationDigest", "signedCheckpointDigests"],
      "properties": {
        "checkpointId": { "type": "string", "pattern": "^CH-(?:0[1-9]|1[0-4])$" }, "journeyId": { "$ref": "#/$defs/safeLabel" }, "outcome": { "const": "passed" },
        "stepCount": { "type": "integer", "minimum": 1, "maximum": 10 }, "observationDigest": { "$ref": "#/$defs/digest" },
        "signedCheckpointDigests": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
      }
    },
    "defect": {
      "type": "object", "additionalProperties": false,
      "required": ["defectDigest", "classification", "disposition", "invalidatedSessionDigest", "invalidatedHead", "fixHead", "invalidatedCheckpointIds", "retestedCheckpointIds"],
      "properties": {
        "defectDigest": { "$ref": "#/$defs/digest" }, "classification": { "const": "material" }, "disposition": { "const": "fixed_retested" },
        "invalidatedSessionDigest": { "$ref": "#/$defs/digest" }, "invalidatedHead": { "$ref": "#/$defs/sha" }, "fixHead": { "$ref": "#/$defs/sha" },
        "invalidatedCheckpointIds": { "$ref": "#/$defs/allCheckpoints" }, "retestedCheckpointIds": { "$ref": "#/$defs/allCheckpoints" }
      }
    },
    "allCheckpoints": {
      "type": "array", "prefixItems": [
        { "const": "CH-01" }, { "const": "CH-02" }, { "const": "CH-03" }, { "const": "CH-04" }, { "const": "CH-05" }, { "const": "CH-06" }, { "const": "CH-07" },
        { "const": "CH-08" }, { "const": "CH-09" }, { "const": "CH-10" }, { "const": "CH-11" }, { "const": "CH-12" }, { "const": "CH-13" }, { "const": "CH-14" }
      ], "items": false, "minItems": 14, "maxItems": 14
    }
  }
}
