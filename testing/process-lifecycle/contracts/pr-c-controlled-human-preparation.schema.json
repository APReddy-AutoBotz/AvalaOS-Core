{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.invalid/schemas/pr-c-controlled-human-preparation-2.json",
  "title": "Governed Delivery and Monitor PR C controlled-human preparation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "controlledHumanDisposition", "prNumber", "branch", "exactHead", "environment", "github", "preview", "backend", "edgeDeployment", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "governed-delivery-monitor-pr-c-controlled-human-preparation-2" },
    "status": { "const": "ready_for_controlled_human" },
    "controlledHumanDisposition": { "const": "not_run" },
    "prNumber": { "const": 264 },
    "branch": { "const": "controller/governed-delivery-monitor-pr-c-20260831" },
    "exactHead": { "$ref": "#/$defs/sha" },
    "environment": { "const": "hosted_nonproduction_pilot" },
    "github": { "$ref": "#/$defs/ciRecord" },
    "preview": { "$ref": "#/$defs/preview" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetFingerprint", "publicTargetDigest", "exerciseDigest", "personaManifestDigest", "fixtureManifestDigest", "migrationTip", "seedCounts", "concurrencyVersion", "controllerPhaseDigests", "productionAuthorized", "customerDataAuthorized", "realProviderCallsAuthorized", "realProviderCallCount", "providerEgressCount"],
      "properties": {
        "targetFingerprint": { "$ref": "#/$defs/digest" },
        "publicTargetDigest": { "$ref": "#/$defs/digest" },
        "exerciseDigest": { "$ref": "#/$defs/digest" },
        "personaManifestDigest": { "$ref": "#/$defs/digest" },
        "fixtureManifestDigest": { "$ref": "#/$defs/digest" },
        "migrationTip": { "const": "20260904120000" },
        "seedCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["studioArtifactCount", "eligibleStudioArtifactCount", "packageCount", "approvedBaselineCount"],
          "properties": {
            "studioArtifactCount": { "const": 2 },
            "eligibleStudioArtifactCount": { "const": 2 },
            "packageCount": { "const": 2 },
            "approvedBaselineCount": { "const": 1 }
          }
        },
        "concurrencyVersion": { "const": 1 },
        "controllerPhaseDigests": {
          "type": "object", "additionalProperties": false,
          "required": ["preflight", "plan", "apply", "verify"],
          "properties": {
            "preflight": { "$ref": "#/$defs/digest" }, "plan": { "$ref": "#/$defs/digest" },
            "apply": { "$ref": "#/$defs/digest" }, "verify": { "$ref": "#/$defs/digest" }
          }
        },
        "productionAuthorized": { "const": false },
        "customerDataAuthorized": { "const": false },
        "realProviderCallsAuthorized": { "const": false },
        "realProviderCallCount": { "const": 0 },
        "providerEgressCount": { "const": 0 }
      }
    },
    "edgeDeployment": {
      "type": "object", "additionalProperties": false,
      "required": ["manifestDigest", "artifactDigest", "producer", "migration", "functions"],
      "properties": {
        "manifestDigest": { "$ref": "#/$defs/digest" }, "artifactDigest": { "$ref": "#/$defs/digest" },
        "producer": { "$ref": "#/$defs/producer" }, "migration": { "$ref": "#/$defs/migration" },
        "functions": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/function" } }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "safeLabel": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "ciRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowPath", "runId", "runAttempt", "conclusion", "artifactName", "artifactDigest"],
      "properties": {
        "workflowPath": { "const": ".github/workflows/transcript-flow-pr-c.yml" }, "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "integer", "minimum": 1 }, "conclusion": { "const": "success" },
        "artifactName": { "$ref": "#/$defs/safeLabel" }, "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "deployId", "releaseSha", "context", "reviewId", "siteName", "environment"],
      "properties": {
        "origin": { "const": "https://deploy-preview-264--avalaos-pilot.netlify.app" }, "deployId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "releaseSha": { "$ref": "#/$defs/sha" }, "context": { "const": "deploy-preview" }, "reviewId": { "const": 264 },
        "siteName": { "const": "avalaos-pilot" }, "environment": { "const": "hosted_nonproduction_pilot" }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowPath", "event", "runId", "runAttempt", "conclusion", "artifactName"],
      "properties": {
        "workflowPath": { "const": ".github/workflows/pr264-controlled-human-edge-deploy.yml" }, "event": { "const": "pull_request" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "runAttempt": { "type": "integer", "minimum": 1 },
        "conclusion": { "const": "success" }, "artifactName": { "$ref": "#/$defs/safeLabel" }
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "sourceDigest", "priorMigrationTip", "migrationTip", "phaseDigests"],
      "properties": {
        "sourcePath": { "const": "supabase/migrations/20260904120000_pr_c_controlled_human_exercise_authority.sql" },
        "sourceDigest": { "$ref": "#/$defs/digest" }, "priorMigrationTip": { "const": "20260831062024" }, "migrationTip": { "const": "20260904120000" },
        "phaseDigests": {
          "type": "object", "additionalProperties": false,
          "required": ["migration-preflight", "migration-apply", "migration-verify"],
          "properties": { "migration-preflight": { "$ref": "#/$defs/digest" }, "migration-apply": { "$ref": "#/$defs/digest" }, "migration-verify": { "$ref": "#/$defs/digest" } }
        }
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "identityDigest", "bundleDigest", "deploymentReceiptDigest", "version", "updatedAtDigest", "runtimeStatus", "observedAt"],
      "properties": {
        "name": { "$ref": "#/$defs/safeLabel" }, "identityDigest": { "$ref": "#/$defs/digest" }, "bundleDigest": { "$ref": "#/$defs/digest" },
        "deploymentReceiptDigest": { "$ref": "#/$defs/digest" }, "version": { "type": "integer", "minimum": 1 },
        "updatedAtDigest": { "$ref": "#/$defs/digest" }, "runtimeStatus": { "type": "integer", "minimum": 200, "maximum": 499, "not": { "const": 404 } },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sourceDigest", "deploymentStatus", "provider"],
      "properties": {
        "name": { "$ref": "#/$defs/safeLabel" }, "sourceDigest": { "$ref": "#/$defs/digest" },
        "deploymentStatus": { "const": "provider_attested_runtime_reachable" }, "provider": { "$ref": "#/$defs/provider" }
      }
    }
  }
}
