{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.invalid/schemas/pr-c-controlled-human-edge-deployment-2.json",
  "title": "Governed Delivery and Monitor PR C Edge exact-source deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "exactHead", "targetFingerprint", "exerciseDigest", "productionAuthorized", "customerDataAuthorized", "realProviderCallsAuthorized", "producer", "migration", "functions", "signature"],
  "properties": {
    "schemaVersion": { "const": "governed-delivery-monitor-pr-c-edge-deployment-manifest-2" },
    "environment": { "const": "hosted_nonproduction_pilot" },
    "exactHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "targetFingerprint": { "$ref": "#/$defs/digest" },
    "exerciseDigest": { "$ref": "#/$defs/digest" },
    "productionAuthorized": { "const": false },
    "customerDataAuthorized": { "const": false },
    "realProviderCallsAuthorized": { "const": false },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowPath", "event", "runId", "runAttempt", "conclusion", "artifactName"],
      "properties": {
        "workflowPath": { "const": ".github/workflows/pr264-controlled-human-edge-deploy.yml" },
        "event": { "const": "pull_request" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "conclusion": { "const": "success" },
        "artifactName": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sourceDigest", "priorMigrationTip", "migrationTip", "phaseDigests"],
      "properties": {
        "sourcePath": { "const": "supabase/migrations/20260904120000_pr_c_controlled_human_exercise_authority.sql" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "priorMigrationTip": { "const": "20260831062024" },
        "migrationTip": { "const": "20260904120000" },
        "phaseDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["migration-preflight", "migration-apply", "migration-verify"],
          "properties": {
            "migration-preflight": { "$ref": "#/$defs/digest" },
            "migration-apply": { "$ref": "#/$defs/digest" },
            "migration-verify": { "$ref": "#/$defs/digest" }
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sourceDigest", "deploymentStatus", "provider"],
        "properties": {
          "name": { "enum": ["assess-command", "assess-v2-command", "enterprise-intelligence-command", "enterprise-intelligence-query", "studio-artifact-command", "studio-private-artifact-command", "tenant-context", "tenant-session", "pr-c-controlled-human-synthetic-generation"] },
          "sourceDigest": { "$ref": "#/$defs/digest" },
          "deploymentStatus": { "const": "provider_attested_runtime_reachable" },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "identityDigest", "bundleDigest", "deploymentReceiptDigest", "version", "updatedAtDigest", "runtimeStatus", "observedAt"],
            "properties": {
              "name": { "enum": ["assess-command", "assess-v2-command", "enterprise-intelligence-command", "enterprise-intelligence-query", "studio-artifact-command", "studio-private-artifact-command", "tenant-context", "tenant-session", "pr-c-controlled-human-synthetic-generation"] },
              "identityDigest": { "$ref": "#/$defs/digest" },
              "bundleDigest": { "$ref": "#/$defs/digest" },
              "deploymentReceiptDigest": { "$ref": "#/$defs/digest" },
              "version": { "type": "integer", "minimum": 1 },
              "updatedAtDigest": { "$ref": "#/$defs/digest" },
              "runtimeStatus": { "type": "integer", "minimum": 200, "maximum": 499, "not": { "const": 404 } },
              "observedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "signature": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
