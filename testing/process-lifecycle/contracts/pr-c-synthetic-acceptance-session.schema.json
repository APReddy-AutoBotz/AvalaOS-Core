{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.invalid/schemas/pr-c-synthetic-acceptance-session-1.json",
  "title": "Governed Delivery and Monitor PR C synthetic role acceptance session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "result", "controlledHuman", "evidenceBasis", "policy", "binding", "personas", "journeys", "checkpoints", "serverObservers", "totals", "lifecycle", "completedAt"],
  "properties": {
    "schemaVersion": { "const": "governed-delivery-monitor-pr-c-synthetic-acceptance-session-1" },
    "status": { "const": "passed" },
    "result": { "const": "SYNTHETIC-ROLE-ACCEPTANCE" },
    "controlledHuman": { "const": "not_run" },
    "evidenceBasis": { "const": "automated_browser_plus_server_observed" },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyId", "policyDigest", "owner", "approvalReference"],
      "properties": {
        "policyId": { "const": "solo-owner-synthetic-v1" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "owner": { "const": "APReddy-AutoBotz" },
        "approvalReference": { "$ref": "#/$defs/safeLabel" }
      }
    },
    "binding": { "$ref": "#/$defs/binding" },
    "personas": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": { "$ref": "#/$defs/persona" }
    },
    "journeys": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": { "$ref": "#/$defs/journey" }
    },
    "checkpoints": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "serverObservers": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/serverObserver" }
    },
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["journeyCount", "checkpointCount", "stepCount", "passedStepCount", "failedStepCount", "blockedStepCount", "providerEgress", "realProviderCalls", "customerDataRecords", "externalUsers"],
      "properties": {
        "journeyCount": { "const": 8 }, "checkpointCount": { "const": 14 }, "stepCount": { "const": 84 }, "passedStepCount": { "const": 84 },
        "failedStepCount": { "const": 0 }, "blockedStepCount": { "const": 0 }, "providerEgress": { "const": 0 }, "realProviderCalls": { "const": 0 },
        "customerDataRecords": { "const": 0 }, "externalUsers": { "const": 0 }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionBindingDigest", "quiesceDigest", "quiescedHistoryDigest", "deprovisionDigest", "independentCleanupDigest", "postInspectionDigest", "status"],
      "properties": {
        "sessionBindingDigest": { "$ref": "#/$defs/digest" },
        "quiesceDigest": { "$ref": "#/$defs/digest" }, "quiescedHistoryDigest": { "$ref": "#/$defs/digest" },
        "deprovisionDigest": { "$ref": "#/$defs/digest" }, "independentCleanupDigest": { "$ref": "#/$defs/digest" },
        "postInspectionDigest": { "$ref": "#/$defs/digest" }, "status": { "const": "verified_deprovisioned" }
      }
    },
    "completedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "safeLabel": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "prNumber", "branch", "exactHead", "preview", "backend", "producer"],
      "properties": {
        "repository": { "const": "APReddy-AutoBotz/AvalaOS-Core" }, "prNumber": { "const": 264 },
        "branch": { "const": "controller/governed-delivery-monitor-pr-c-20260831" }, "exactHead": { "$ref": "#/$defs/sha" },
        "preview": {
          "type": "object", "additionalProperties": false,
          "required": ["origin", "deployId", "releaseSha", "environment", "context", "reviewId", "siteName"],
          "properties": {
            "origin": { "const": "https://deploy-preview-264--avalaos-pilot.netlify.app" }, "deployId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
            "releaseSha": { "$ref": "#/$defs/sha" }, "environment": { "const": "hosted_nonproduction_pilot" },
            "context": { "const": "deploy-preview" }, "reviewId": { "const": 264 }, "siteName": { "const": "avalaos-pilot" }
          }
        },
        "backend": {
          "type": "object", "additionalProperties": false,
          "required": ["exerciseDigest", "targetFingerprint", "publicTargetDigest", "personaManifestDigest", "fixtureManifestDigest", "migrationTip"],
          "properties": {
            "exerciseDigest": { "$ref": "#/$defs/digest" }, "targetFingerprint": { "$ref": "#/$defs/digest" },
            "publicTargetDigest": { "$ref": "#/$defs/digest" }, "personaManifestDigest": { "$ref": "#/$defs/digest" },
            "fixtureManifestDigest": { "$ref": "#/$defs/digest" }, "migrationTip": { "const": "20260926053818" }
          }
        },
        "producer": {
          "type": "object", "additionalProperties": false,
          "required": ["workflowPath", "job", "event", "runId", "runAttempt", "owner"],
          "properties": {
            "workflowPath": { "const": ".github/workflows/transcript-flow-pr-c.yml" }, "job": { "const": "synthetic_role_acceptance" },
            "event": { "const": "workflow_dispatch" }, "runId": { "$ref": "#/$defs/runId" }, "runAttempt": { "type": "integer", "minimum": 1 },
            "owner": { "const": "APReddy-AutoBotz" }
          }
        }
      }
    },
    "persona": {
      "type": "object", "additionalProperties": false,
      "required": ["personaKey", "role", "applicationActorDigest", "applicationSessionDigest", "signedOutAt", "signOutEvidenceDigest"],
      "properties": {
        "personaKey": { "$ref": "#/$defs/safeLabel" }, "role": { "enum": ["requester", "reviewer", "approver"] },
        "applicationActorDigest": { "$ref": "#/$defs/digest" }, "applicationSessionDigest": { "$ref": "#/$defs/digest" },
        "signedOutAt": { "$ref": "#/$defs/timestamp" }, "signOutEvidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "journey": {
      "type": "object", "additionalProperties": false,
      "required": ["journeyId", "checkpointIds", "outcome"],
      "properties": {
        "journeyId": { "$ref": "#/$defs/safeLabel" }, "checkpointIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^CH-(?:0[1-9]|1[0-4])$" } },
        "outcome": { "const": "passed" }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpointId", "journeyId", "testIds", "outcome", "steps"],
      "properties": {
        "checkpointId": { "type": "string", "pattern": "^CH-(?:0[1-9]|1[0-4])$" }, "journeyId": { "$ref": "#/$defs/safeLabel" },
        "testIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeLabel" } }, "outcome": { "const": "passed" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/browserStep" } }
      }
    },
    "browserStep": {
      "type": "object", "additionalProperties": false,
      "required": ["stepId", "personaKey", "outcome", "startedAt", "completedAt", "applicationActorDigest", "applicationSessionDigest", "browserArtifact"],
      "properties": {
        "stepId": { "$ref": "#/$defs/safeLabel" }, "personaKey": { "$ref": "#/$defs/safeLabel" }, "outcome": { "const": "passed" },
        "startedAt": { "$ref": "#/$defs/timestamp" }, "completedAt": { "$ref": "#/$defs/timestamp" },
        "applicationActorDigest": { "$ref": "#/$defs/digest" }, "applicationSessionDigest": { "$ref": "#/$defs/digest" },
        "browserArtifact": { "$ref": "#/$defs/browserArtifact" }
      }
    },
    "browserArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "route", "viewport", "assertions", "interactionSequence", "serverAnchor", "serverBinding"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/safeLabel" }, "route": { "type": "string", "pattern": "^/[a-z0-9/_?=&.-]{0,255}$" }, "viewport": { "$ref": "#/$defs/safeLabel" },
        "assertions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/browserAssertion" } },
        "interactionSequence": { "type": "array", "minItems": 1, "maxItems": 80, "items": { "$ref": "#/$defs/safeLabel" } },
        "serverAnchor": { "anyOf": [{ "type": "null" }, { "type": "object" }] }, "serverBinding": { "anyOf": [{ "type": "null" }, { "type": "object" }] }
      }
    },
    "browserAssertion": {
      "type": "object", "additionalProperties": false,
      "required": ["assertionId", "kind", "result", "actualDigest"],
      "properties": {
        "assertionId": { "$ref": "#/$defs/safeLabel" }, "kind": { "enum": ["dom", "accessibility", "layout", "navigation", "network"] },
        "result": { "const": "passed" }, "actualDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "serverObserver": {
      "type": "object",
      "required": ["contractVersion", "phase", "status", "executionKind", "syntheticRole", "requestDigest", "steps"],
      "properties": {
        "contractVersion": { "const": "pr-c-controlled-human-controller-1" }, "phase": { "const": "checkpoint-observe" }, "status": { "const": "passed" },
        "executionKind": { "const": "synthetic" }, "syntheticRole": { "enum": ["requester", "reviewer", "approver"] }, "requestDigest": { "$ref": "#/$defs/digest" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/serverStep" } }
      }
    },
    "serverStep": {
      "type": "object",
      "required": ["checkpointId", "stepId", "personaKey", "executionKind", "applicationActorDigest", "applicationSessionDigest", "machineAttemptDigest", "inspectionDigest", "safety"],
      "properties": {
        "checkpointId": { "type": "string", "pattern": "^CH-(?:0[1-9]|1[0-4])$" }, "stepId": { "$ref": "#/$defs/safeLabel" }, "personaKey": { "$ref": "#/$defs/safeLabel" },
        "executionKind": { "const": "synthetic" }, "applicationActorDigest": { "$ref": "#/$defs/digest" }, "applicationSessionDigest": { "$ref": "#/$defs/digest" },
        "machineAttemptDigest": { "$ref": "#/$defs/digest" }, "inspectionDigest": { "$ref": "#/$defs/digest" },
        "safety": {
          "type": "object", "additionalProperties": false,
          "required": ["providerEgress", "realProviderCalls", "customerDataRecords", "externalUsers"],
          "properties": { "providerEgress": { "const": 0 }, "realProviderCalls": { "const": 0 }, "customerDataRecords": { "const": 0 }, "externalUsers": { "const": 0 } }
        }
      }
    }
  }
}
