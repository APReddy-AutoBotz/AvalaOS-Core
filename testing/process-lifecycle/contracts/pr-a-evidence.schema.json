{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalaos.example/contracts/process-lifecycle-pr-a-evidence-3.schema.json",
  "title": "Governed transcript PR A per-assertion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "baseGitSha", "headGitSha", "workingTreeDigest", "workflow", "testId", "result", "command", "assertion"],
  "properties": {
    "contractVersion": { "const": "process-lifecycle-pr-a-evidence-3" },
    "baseGitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "headGitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workingTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workflow": { "type": "object", "required": ["path", "runId", "runAttempt", "exactHeadGitSha"], "additionalProperties": true },
    "testId": { "type": "string", "pattern": "^(SRCSET|ASSESS-TR|AUTH|IDEMP|BUDGET|PROVIDER|INJECTION|A11Y|PERF)-[0-9]{3}(?:-[A-Z])?$" },
    "result": { "enum": ["passed", "not_run"] },
    "reason": { "type": "string" },
    "command": { "type": ["object", "null"] },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["runtimeContext", "runtimeContextDigest", "marker", "markerDigest", "commandRecordDigest"],
          "properties": {
            "runtimeContext": { "$ref": "#/$defs/runtimeContext" },
            "runtimeContextDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "marker": { "type": "object" },
            "markerDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "commandRecordDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        { "type": "object", "required": ["facts"], "properties": { "facts": { "type": "object", "properties": { "executed": { "const": false } }, "required": ["executed"] } } }
      ]
    }
  },
  "$defs": {
    "runtimeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona", "organizationId", "workspaceId", "fixtureIds", "lineage"],
      "properties": {
        "persona": {
          "type": "object", "additionalProperties": false, "required": ["id", "state", "capabilities"],
          "properties": { "id": { "type": "string" }, "state": { "enum": ["active", "revoked", "revoked-then-restored"] }, "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }
        },
        "organizationId": { "type": "string" }, "workspaceId": { "type": "string" },
        "fixtureIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "lineage": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceVersionSelectors", "sourceSets", "inputBundles", "extractionJobIds", "extractionBindingIds", "candidates", "previewBatchIds", "assessDrafts"],
          "properties": {
            "sourceVersionSelectors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "sourceSets": { "type": "array", "items": { "$ref": "#/$defs/versionedSelector" } },
            "inputBundles": { "type": "array", "items": { "$ref": "#/$defs/versionedSelector" } },
            "extractionJobIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "extractionBindingIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "candidates": { "type": "array", "items": { "$ref": "#/$defs/versioned" } },
            "previewBatchIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "assessDrafts": { "type": "array", "items": { "$ref": "#/$defs/versioned" } }
          }
        }
      }
    },
    "versionedSelector": { "type": "object", "additionalProperties": false, "required": ["id", "versionSelector", "version"], "properties": { "id": { "type": "string" }, "versionSelector": { "type": "string" }, "version": { "type": "integer", "minimum": 1 } } },
    "versioned": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 } } }
  }
}
